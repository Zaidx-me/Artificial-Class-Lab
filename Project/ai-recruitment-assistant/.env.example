# --- LLM (any OpenAI-compatible endpoint) ---
# OpenAI:  LLM_BASE_URL=            LLM_MODEL=gpt-4o-mini
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1
# NVIDIA:  LLM_BASE_URL=https://integrate.api.nvidia.com/v1  LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#   (the base URL must match the key's provider, or you'll get a 401)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Set to 1 to run with the built-in offline mock LLM (no API key, for testing)
USE_MOCK_LLM=0
# Reasoning models (e.g. NVIDIA Nemotron) "think" before every reply, which is slow and can
# return empty text. Leave blank to auto-disable thinking on NVIDIA endpoints, or set 1/0 to force.
LLM_DISABLE_THINKING=

# --- Email (credentials are read from this file only) ---
# Gmail: enable 2-Step Verification, then create an App password
# (Google Account -> Security -> App passwords) and paste the 16 characters here.
# Without credentials, the agent reads .eml files from assets/inbox.
IMAP_SERVER=imap.gmail.com
EMAIL_USER=
EMAIL_PASS=

# --- Outbound email (sending) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
